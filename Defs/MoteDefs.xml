<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        Progress bar shown over a Momo while she forms the tsugai bond.
        Same look as the vanilla work progress bar, but pink (see
        ProjectMomo.MoteBondProgressBar, which draws it with pink materials).
    -->
    <ThingDef ParentName="MoteBase" Name="ProjectMomo_MoteBondProgressBar">
        <defName>ProjectMomo_MoteBondProgressBar</defName>
        <graphicData>
            <texPath>Things/Mote/Transparent</texPath>
        </graphicData>
        <thingClass>ProjectMomo.MoteBondProgressBar</thingClass>
        <altitudeLayer>MetaOverlays</altitudeLayer>
        <mote>
            <solidTime>999</solidTime>
        </mote>
    </ThingDef>
</Defs>
