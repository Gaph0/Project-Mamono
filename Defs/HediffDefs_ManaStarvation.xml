<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        Mana starvation: the chemical-dependency-style escalating decline for a Momo
        whose Mana need is empty. Severity is driven by Need_Mana (0 while fed, grows
        the longer she starves). Never lethal — she collapses, not dies, per lore.
    -->
    <HediffDef>
        <defName>ProjectMomo_ManaStarvation</defName>
        <label>mana starvation</label>
        <description>This Momo has gone too long without essence. Her demonic energy is spent, leaving her weak and increasingly desperate.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.7, 0.4, 0.9)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>0</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
            </li>
            <li>
                <minSeverity>0.25</minSeverity>
                <label>drained</label>
                <becomeVisible>true</becomeVisible>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <setMax>0.9</setMax>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.6</minSeverity>
                <label>desperate</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.7</setMax>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <setMax>0.8</setMax>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <setMax>0.6</setMax>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>1</minSeverity>
                <overrideLabel>collapsed</overrideLabel>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <setMax>0.1</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>
