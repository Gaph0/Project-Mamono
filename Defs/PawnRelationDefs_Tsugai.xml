<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        Tsugai: the lifelong bond between a Momo and the man she has claimed as her
        husband. Shown on the Social tab. Reflexive so it appears on both pawns.
    -->
    <PawnRelationDef>
        <workerClass>ProjectMomo.PawnRelationWorker_Tsugai</workerClass>
        <defName>ProjectMomo_Tsugai</defName>
        <label>bonded</label>
        <labelFemale>bonded</labelFemale>
        <importance>210</importance>
        <opinionOffset>100</opinionOffset>
        <implied>false</implied>
        <reflexive>true</reflexive>
    </PawnRelationDef>
</Defs>
