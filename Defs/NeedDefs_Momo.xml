
<Defs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="rimworld DefsSchema.xsd" xmlns="rimworld">
    <!--
        Mana: a need unique to Momo-carriers. Gated by onlyIfCausedByGene + the
        Momo gene's <enablesNeeds>, so ONLY carriers ever have it.
    -->
    <NeedDef>
        <defName>ProjectMomo_Mana</defName>
        <needClass>ProjectMomo.Need_Mana</needClass>
        <label>mana</label>
        <description>A Momo's reserve of demonic energy, gathered from the essence of men. It slowly drains away and must be replenished, or she grows desperate.</description>
        <baseLevel>0.5</baseLevel>
        <listPriority>750</listPriority>
        <major>true</major>
        <minIntelligence>Humanlike</minIntelligence>
        <onlyIfCausedByGene>true</onlyIfCausedByGene>
    </NeedDef>

    <!--
        Essence: a need on ordinary humans (the resource Momos feed on). Gated to
        humanlikes via minIntelligence, and removed from Momo-carriers by the Momo
        gene's <disablesNeeds>.
    -->
    <NeedDef>
        <defName>ProjectMomo_Essence</defName>
        <needClass>ProjectMomo.Need_Essence</needClass>
        <label>essence</label>
        <description>Life energy held by ordinary humans, densest in men. Momos draw on it to sustain their mana. When drained, a person is left spent.</description>
        <baseLevel>0.8</baseLevel>
        <listPriority>760</listPriority>
        <major>true</major>
        <minIntelligence>Humanlike</minIntelligence>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    </NeedDef>
</Defs>
