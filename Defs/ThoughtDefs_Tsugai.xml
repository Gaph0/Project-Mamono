
<Defs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="rimworld DefsSchema.xsd" xmlns="rimworld">
    <ThoughtDef>
        <defName>ProjectMomo_TsugaiFormed</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>5</durationDays>
        <stackLimit>3</stackLimit>
        <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
        <stages>
            <li>
                <label>found my mate</label>
                <description>I've found the one my heart and body yearn for. I feel complete.</description>
                <baseMoodEffect>10</baseMoodEffect>
            </li>
            <li>
                <label>found my mates</label>
                <description>Two hearts now beat with mine. I am doubly blessed.</description>
                <baseMoodEffect>16</baseMoodEffect>
            </li>
            <li>
                <label>surrounded by mates</label>
                <description>So many hearts bound to mine - I have never felt so loved and complete.</description>
                <baseMoodEffect>22</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- Granted to both partners of a voluntary (consensual) bond, remembered against each other. -->
    <ThoughtDef>
        <defName>ProjectMomo_TsugaiWilling</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <durationDays>8</durationDays>
        <stackLimit>3</stackLimit>
        <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
        <stages>
            <li>
                <label>bound by choice</label>
                <description>We chose each other freely, and the bond sealed that choice. My heart is singing.</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- The initiator's sting when a bond proposal is turned down. -->
    <ThoughtDef>
        <defName>ProjectMomo_TsugaiRejected</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <durationDays>2</durationDays>
        <stackLimit>3</stackLimit>
        <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
        <stages>
            <li>
                <label>bond proposal rejected</label>
                <description>I offered my bond and was turned away. It stings more than I expected.</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>
</Defs>
