<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Grief debuff applied to a surviving partner when a tsugai bond dies. -->
    <HediffDef>
        <defName>ProjectMomo_TsugaiLoss</defName>
        <label>bond grief</label>
        <description>Their bonded mate has died. The severed tsugai bond leaves a hollow ache that saps their will.</description>
        <hediffClass>ProjectMomo.Hediff_TsugaiLoss</hediffClass>
        <defaultLabelColor>(1.0, 0.4, 0.6)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <label>grieving</label>
            </li>
        </stages>
        <comps>
            <!-- Duration is overridden in code from the BondLossMinDays/MaxDays
                 settings; this range is only a fallback. -->
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>
                    <min>300000</min>  <!-- 5 days -->
                    <max>600000</max>  <!-- 10 days -->
                </disappearsAfterTicks>
            </li>
        </comps>
    </HediffDef>
</Defs>
