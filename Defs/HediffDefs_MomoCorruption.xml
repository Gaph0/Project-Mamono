
<Defs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="rimworld DefsSchema.xsd" xmlns="rimworld">
    <!--
        Mamono corruption: a Momo's mana slowly rewriting a woman into a monster.
        Severity only grows through completed mana infusions (JobDriver_InfuseMomo);
        while the victim is on her feet she fights it off and the corruption
        decays (the gate is being downed, not willpower), so partial corruption is
        reversible. At full severity the transformation fires and this hediff is
        removed. The hediff remembers the most recent infuser's xenotype — the
        last Momo to corrupt her decides what she becomes.
    -->
    <HediffDef>
        <defName>ProjectMomo_MomoCorruption</defName>
        <label>mamono corruption</label>
        <description>A Momo's mana is slowly rewriting this woman's body and mind. If the corruption runs its course, she will awaken as a monster herself. It fades while she is on her feet; each infusion while she is helpless brings her closer to the change.</description>
        <hediffClass>ProjectMomo.Hediff_MomoCorruption</hediffClass>
        <defaultLabelColor>(1.0, 0.6, 0.8)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>0.05</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <label>mana-touched</label>
            </li>
            <li>
                <minSeverity>0.25</minSeverity>
                <label>infused</label>
            </li>
            <li>
                <minSeverity>0.5</minSeverity>
                <label>blooming</label>
            </li>
            <li>
                <minSeverity>0.8</minSeverity>
                <label>on the verge</label>
            </li>
        </stages>
    </HediffDef>
</Defs>
