<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>ProjectMomo_WillpowerBreak</defName>
        <label>broken will</label>
        <description>The victim's willpower has crumbled completely, leaving them collapsed and helpless — conscious, but unable to resist.</description>
        <hediffClass>ProjectMomo.Hediff_WillpowerBreak</hediffClass>
        <defaultLabelColor>(1.0, 0.6, 0.8)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <label>broken</label>
                <!-- Zero out Moving (not Consciousness) so the pawn is downed by
                     ShouldBeDowned's !CapableOf(Moving) check while staying awake. -->
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <setMax>0</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>
