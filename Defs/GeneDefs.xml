
<Defs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="rimworld DefsSchema.xsd" xmlns="rimworld">
    <GeneDef>
        <defName>ProjectMomo_Momo</defName>
        <label>Momo</label>
        <description>This monster bears the mark of the current Mamono Lord.</description>
        <iconPath>UI/Icons/Genes/Gene_Fertile</iconPath>
        <geneClass>ProjectMomo.Gene_Momo</geneClass>
        <displayCategory>Reproduction</displayCategory>
        <displayOrderInCategory>1000</displayOrderInCategory>
        <biostatMet>3</biostatMet>
        <enablesNeeds>
            <li>ProjectMomo_Mana</li>
        </enablesNeeds>
        <disablesNeeds>
            <li>ProjectMomo_Essence</li>
        </disablesNeeds>
        <customEffectDescriptions>
            <li>This monster bears the mark of the current Mamono Lord.</li>
            <li>Melee strikes inflict tease damage on pawns without this gene, eroding their willpower.</li>
            <li>Her fertility never fades with age.</li>
            <li>The ailments of old age never touch her; ones she already has silently melt away.</li>
        </customEffectDescriptions>
    </GeneDef>

    <!--
        Flight: grants a leap-style "Fly" ability gizmo and makes the pawn count
        as a flying mount in caravans. The CaravanRidingSpeedFactor offset (base
        1.0 + 2.5 = 3.5x) is read by CaravanMountSpeedPatch, which counts every
        flyer twice: once for herself and once for a passenger riding on her back.

        Wing swap limitation (confirmed 2026-09-20): the body swap below only
        works on a pawn whose race def is literally Human - dragons, wyverns and
        lamias, which are xenotype-only species. B&S's gene path runs
        SwapThingDef with force:false + targetPriority:0 (Genes/GenePatches.cs),
        and a race def that isn't Human is entered at priority 200, so it wins
        the "no fusion found" fallback and the swap is silently refused. A
        species on its own race def must carry the winged body and
        BS_HumanoidWithWings_Race on its race def instead (see the winged insect
        momos in Project Momo Insects). The Flagger below is still required
        there: the winged tracker blanks its own art for "Wings"-tagged genes.
    -->
    <GeneDef>
        <defName>PMM_Gene_Flight</defName>
        <label>flight</label>
        <description>This woman's body bears powerful wings. She can soar across the battlefield at will, and on the world map she flies - strong enough to carry a passenger on her back.</description>
        <iconPath>UI/Icons/Genes/Gene_LongJumpLegs</iconPath>
        <displayCategory>Movement</displayCategory>
        <displayOrderInCategory>1000</displayOrderInCategory>
        <biostatMet>-2</biostatMet>
        <abilities>
            <li>PMM_Ability_FlightLeap</li>
        </abilities>
        <statOffsets>
            <CaravanRidingSpeedFactor>2.5</CaravanRidingSpeedFactor>
        </statOffsets>
        <customEffectDescriptions>
            <li>Grants the "Fly" ability: leap through the air to a distant location, soaring over obstacles.</li>
            <li>In a caravan she flies instead of walking, and can airlift one passenger on her back: each flyer counts as two caravan members moving at 350% speed.</li>
            <li>On foot she ignores rough ground: mud, sand, snow and slush never slow her down, and she crosses water at her own pace.</li>
        </customEffectDescriptions>
        <descriptionHyperlinks>
            <AbilityDef>PMM_Ability_FlightLeap</AbilityDef>
        </descriptionHyperlinks>
        <!-- Big & Small: draw the wings. Two pieces, both needed:
             1. thingDefSwap -> BS_HumanoidWithWings gives the pawn the winged BODY
                (real BS_Wing parts) and applies B&S's BS_HumanoidWithWings_Race
                tracker hediff. The tracker is the ONLY wing renderer we use.
             2. The Flagger un-blanks that tracker: it hides its wing graphics on
                pawns carrying a gene tagged Wing/Wings (it expects the separate
                BigSmall_Genes mod to draw them). Raising ShowBaseWingsRight/Left
                tells the tracker to keep drawing its own feathered wings - the
                same trick PMM_Gene_LamiaTail uses with ShowBaseAbdomen.
             We deliberately ship NO custom render hediff: the tracker alone draws
             the wings (confirmed in-game), and a second renderer would just draw
             the same textures twice.
             exclusionTags keep it from stacking with other wing swaps, and keep
             it off a woman who carries the large frame gene: PMM_CaravanCarrier is
             the shared tag that makes the two caravan genes exclusive. -->
        <exclusionTags>
            <li>Wings</li>
            <li>PMM_CaravanCarrier</li>
        </exclusionTags>
        <modExtensions>
            <li Class="BigAndSmall.PawnExtension">
                <!-- forceThingDefSwap: the cautious (non-forced) swap silently
                     refused on dragons - no BS_Wing parts, no tracker, no wings.
                     The lamia tail gets away with cautious because lamias start
                     plain. Dragons need the forced path. -->
                <forceThingDefSwap>true</forceThingDefSwap>
                <!-- renderCacheOff: same as the lamia tail. Wings reach past the
                     body render atlas; without this they get cropped. -->
                <renderCacheOff>true</renderCacheOff>
                <thingDefSwap>BS_HumanoidWithWings</thingDefSwap>
                <!-- No part-toughness hediff here (removed 2026-09-23). A
                     hediff cannot change part HP at all - that is
                     hitPoints x HealthScale - and addedPartProps is only read
                     for Hediff_AddedPart, so PMM_Hediff_PartToughness was a
                     no-op that still showed up in the Health tab. -->
            </li>
            <!-- Keep the B&S race tracker from hiding its wing graphics on the
                 gene path. Same pattern as the lamia tail's ShowBaseAbdomen. -->
            <li Class="BigAndSmall.Flagger">
                <flags>
                    <ShowBaseWingsRight />
                    <ShowBaseWingsLeft />
                </flags>
            </li>
        </modExtensions>
    </GeneDef>

    <!--
        Weak flight: the same wings and the same "fly" leap as PMM_Gene_Flight,
        for momos with thin, weak wings (the vamp mosquito and soldier beetle).
        Two differences from the strong gene:
          1. No CaravanRidingSpeedFactor offset - the stat stays at its 1.0 base,
             so CaravanMountSpeedPatch never counts her as a mount. She flies
             for herself only: no passenger, and no faster caravan travel.
          2. She draws her OWN, smaller wings (renderNodeProperties below). The
             strong gene instead raises ShowBaseWingsRight/Left so the winged
             body/race tracker keeps drawing its full-size wings. This gene has
             no Flagger on purpose: the winged tracker blanks itself for a
             wings-tagged gene, so its big wings vanish and only these smaller
             ones draw. One gene therefore serves every race - the vamp
             mosquito and the soldier beetle get this exact smaller set.
        The shared Wings exclusion tag keeps the two flight genes from stacking.
        Cheaper than the strong gene (-1 metabolic efficiency instead of -2)
        because she gives up the mount.
    -->
    <GeneDef>
        <defName>PMM_Gene_FlightWeak</defName>
        <label>weak flight</label>
        <description>This woman's wings are thin and too weak to lift more than herself. She can still fly, but she cannot carry a passenger or hurry a caravan along.</description>
        <iconPath>UI/Icons/Genes/Gene_LongJumpLegs</iconPath>
        <displayCategory>Movement</displayCategory>
        <displayOrderInCategory>1000</displayOrderInCategory>
        <biostatMet>-1</biostatMet>
        <abilities>
            <li>PMM_Ability_FlightLeap</li>
        </abilities>
        <customEffectDescriptions>
            <li>Grants the "Fly" ability: leap through the air to a distant location, soaring over obstacles.</li>
            <li>Her wings lift only herself: she carries no passenger and adds no mount of her own.</li>
            <li>On foot she ignores rough ground: mud, sand, snow and slush never slow her down, and she crosses water at her own pace.</li>
        </customEffectDescriptions>
        <descriptionHyperlinks>
            <AbilityDef>PMM_Ability_FlightLeap</AbilityDef>
        </descriptionHyperlinks>
        <exclusionTags>
            <li>Wings</li>
        </exclusionTags>
        <!-- Same Big & Small body plumbing as PMM_Gene_Flight: forced body swap
             (which also brings the real BS_Wing parts) and render cache off
             (wings reach past the body atlas). No toughness hediff and no
             Flagger here - see the notes above. -->
        <modExtensions>
            <li Class="BigAndSmall.PawnExtension">
                <forceThingDefSwap>true</forceThingDefSwap>
                <renderCacheOff>true</renderCacheOff>
                <thingDefSwap>BS_HumanoidWithWings</thingDefSwap>
            </li>
        </modExtensions>
        <!--
            Her wings: the same six nodes B&S puts on BS_HumanoidWithWings_Race
            (BS_FeatheredWingFront/Inner/Back, each side, with their layers and
            facings), at drawSize 0.8 instead of B&S's 1.23 - about 65% of a
            strong flyer's wings. The six drawSize lines are the only knob.

            Only the body-part alt is kept: no BS_Wing part, no wings. The
            gene-tag alt from B&S's tracker is deliberately absent, because this
            gene carries the Wings tag itself and would blank its own art.
        -->
        <renderNodeProperties>
            <li Class="BigAndSmall.PawnRenderingProps_Ultimate">
                <nodeClass>BigAndSmall.PawnRenderNode_Ultimate</nodeClass>
                <workerClass>BigAndSmall.UltimateRenderNodeWorker</workerClass>
                <parentTagDef>Body</parentTagDef>
                <shader>BS_TransparentThreeColor</shader>
                <conditionalGraphics>
                    <props><replaceFlags><WingGraphics /></replaceFlags></props>
                    <conditionalPaths><altDefs><li>BS_FeatheredWingFront</li></altDefs></conditionalPaths>
                    <colorA><altDefs><li>BS_WingClrDark_A</li></altDefs></colorA>
                    <colorB><altDefs><li>BS_WingClrDark_B</li></altDefs></colorB>
                    <alts>
                        <li>
                            <triggerBodyPart>
                                <li><bodyPartDef>BS_Wing</bodyPartDef><mirrored>false</mirrored><partMissing>true</partMissing></li>
                                <li><bodyPartDef>BS_Mech_Wing</bodyPartDef><mirrored>false</mirrored><partMissing>true</partMissing></li>
                            </triggerBodyPart>
                            <texturePaths><default>BS_Blank</default></texturePaths>
                        </li>
                    </alts>
                </conditionalGraphics>
                <drawSize>(0.8,0.8)</drawSize>
                <visibleFacing><li>South</li><li>East</li></visibleFacing>
                <drawData><defaultData><layer>92</layer></defaultData></drawData>
            </li>
            <li Class="BigAndSmall.PawnRenderingProps_Ultimate">
                <nodeClass>BigAndSmall.PawnRenderNode_Ultimate</nodeClass>
                <workerClass>BigAndSmall.UltimateRenderNodeWorker</workerClass>
                <parentTagDef>Body</parentTagDef>
                <shader>BS_TransparentThreeColor</shader>
                <conditionalGraphics>
                    <props><replaceFlags><WingGraphics /></replaceFlags></props>
                    <conditionalPaths><altDefs><li>BS_FeatheredWingInner</li></altDefs></conditionalPaths>
                    <colorA><altDefs><li>BS_WingClr_A</li></altDefs></colorA>
                    <colorB><altDefs><li>BS_WingClrSaturated_B</li></altDefs></colorB>
                    <alts>
                        <li>
                            <triggerBodyPart>
                                <li><bodyPartDef>BS_Wing</bodyPartDef><mirrored>false</mirrored><partMissing>true</partMissing></li>
                                <li><bodyPartDef>BS_Mech_Wing</bodyPartDef><mirrored>false</mirrored><partMissing>true</partMissing></li>
                            </triggerBodyPart>
                            <texturePaths><default>BS_Blank</default></texturePaths>
                        </li>
                    </alts>
                </conditionalGraphics>
                <drawSize>(0.8,0.8)</drawSize>
                <visibleFacing><li>South</li><li>East</li><li>North</li></visibleFacing>
                <drawData><defaultData><layer>-1</layer></defaultData><dataNorth><layer>92</layer><flip>true</flip></dataNorth></drawData>
            </li>
            <li Class="BigAndSmall.PawnRenderingProps_Ultimate">
                <nodeClass>BigAndSmall.PawnRenderNode_Ultimate</nodeClass>
                <workerClass>BigAndSmall.UltimateRenderNodeWorker</workerClass>
                <parentTagDef>Body</parentTagDef>
                <shader>BS_TransparentThreeColor</shader>
                <conditionalGraphics>
                    <props><replaceFlags><WingGraphics /></replaceFlags></props>
                    <conditionalPaths><altDefs><li>BS_FeatheredWingBack</li></altDefs></conditionalPaths>
                    <colorA><altDefs><li>BS_WingClrSaturated_A</li></altDefs></colorA>
                    <colorB><altDefs><li>BS_WingClrDark_B</li></altDefs></colorB>
                    <alts>
                        <li>
                            <triggerBodyPart>
                                <li><bodyPartDef>BS_Wing</bodyPartDef><mirrored>false</mirrored><partMissing>true</partMissing></li>
                                <li><bodyPartDef>BS_Mech_Wing</bodyPartDef><mirrored>false</mirrored><partMissing>true</partMissing></li>
                            </triggerBodyPart>
                            <texturePaths><default>BS_Blank</default></texturePaths>
                        </li>
                    </alts>
                </conditionalGraphics>
                <drawSize>(0.8,0.8)</drawSize>
                <visibleFacing><li>West</li></visibleFacing>
                <drawData><defaultData><layer>-2</layer></defaultData><dataEast><flip>true</flip></dataEast></drawData>
            </li>
            <li Class="BigAndSmall.PawnRenderingProps_Ultimate">
                <nodeClass>BigAndSmall.PawnRenderNode_Ultimate</nodeClass>
                <workerClass>BigAndSmall.UltimateRenderNodeWorker</workerClass>
                <parentTagDef>Body</parentTagDef>
                <shader>BS_TransparentThreeColor</shader>
                <conditionalGraphics>
                    <props><replaceFlags><WingGraphics /></replaceFlags></props>
                    <conditionalPaths><altDefs><li>BS_FeatheredWingFront</li></altDefs></conditionalPaths>
                    <colorA><altDefs><li>BS_WingClrDark_A</li></altDefs></colorA>
                    <colorB><altDefs><li>BS_WingClrDark_B</li></altDefs></colorB>
                    <alts>
                        <li>
                            <triggerBodyPart>
                                <li><bodyPartDef>BS_Wing</bodyPartDef><mirrored>true</mirrored><partMissing>true</partMissing></li>
                                <li><bodyPartDef>BS_Mech_Wing</bodyPartDef><mirrored>true</mirrored><partMissing>true</partMissing></li>
