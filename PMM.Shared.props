<Project>
  <!-- Shared paths and compiler settings for all Project Momo mods.
       The core project (ProjectMomo.csproj, Zlepper SDK) defines its own
       values and does not import this file. Sub-mods import it explicitly:
       <Import Project="..\Project Momo\PMM.Shared.props" /> -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RimWorldPath>/home/gapho/.steam/debian-installation/steamapps/common/RimWorld</RimWorldPath>
    <RimWorldManagedPath>$(RimWorldPath)/RimWorldLinux_Data/Managed</RimWorldManagedPath>
    <SteamModContentFolder>/home/gapho/.steam/debian-installation/steamapps/workshop/content/294100</SteamModContentFolder>
    <!-- Big and Small Framework, installed locally (not the workshop copy). -->
    <BigSmallPath>$(RimWorldPath)/Mods/Big and Small - Framework</BigSmallPath>
  </PropertyGroup>

  <!-- References shared by every Project Momo mod. Private=false: never
       copied to the output folder, so Assemblies/ stays clean. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(RimWorldManagedPath)/netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SteamModContentFolder)/2009463077/Current/Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BigAndSmall">
      <HintPath>$(BigSmallPath)/1.6/Base/Assemblies/BigAndSmall.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BSXeno">
      <HintPath>$(BigSmallPath)/1.6/Base/Assemblies/BSXeno.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy only the mod's own dll into Assemblies/ after build, replacing
       what build.sh used to produce directly. -->
  <Target Name="CopyToModAssemblies" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)/Assemblies" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/Assemblies" />
    <Message Text="Copied $(AssemblyName).dll to Assemblies/" Importance="high" />
  </Target>
</Project>
