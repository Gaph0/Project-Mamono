<Project>
  <Import Project="Sdk.props" Sdk="Zlepper.RimWorld.ModSdk" />

  <PropertyGroup>
    <RimWorldModName>Project Mamono</RimWorldModName>
    <RimWorldPackageId>PMM.Core</RimWorldPackageId>
    <Authors>Gapho</Authors>
    <Description>Framework for Project Mamono</Description>
    <RimWorldPath>/home/gapho/.steam/debian-installation/steamapps/common/RimWorld</RimWorldPath>
    <RimWorldManagedPath>$(RimWorldPath)/RimWorldLinux_Data/Managed</RimWorldManagedPath>
    <SteamModContentFolder>/home/gapho/.steam/debian-installation/steamapps/workshop/content/294100</SteamModContentFolder>
    <IncludeHarmony>true</IncludeHarmony>
  </PropertyGroup>

  <ItemGroup>
    <RimWorldSteamModDependency Include="OskarPotocki.VanillaFactionsExpanded.Core" />
    <RimWorldSteamModDependency Include="VanillaExpanded.VPsycastsE" />
    <RimWorldSteamModDependency Include="com.yayo.yayoAni.continued" />
    <!-- Requires ISEKAI RPG LEVELING (workshop id 3657580708) to be installed -->
    <RimWorldSteamModDependency Include="JellyCreative.IsekaiLeveling">
      <MainDllName>IsekaiLeveling</MainDllName>
    </RimWorldSteamModDependency>
  </ItemGroup>

  <!-- Big and Small Framework, referenced straight out of its workshop folder (id
       2925432336) rather than through RimWorldSteamModDependency, which wants a packageId
       this mod does not publish. A direct reference with a versioned hint path works for both
       compiling and XSD generation (the XSD task reflects over @(Reference)). Unlike a copy in
       the local Mods folder, a Steam update cannot delete this one. -->
  <ItemGroup>
    <Reference Include="BigAndSmall">
      <HintPath>$(SteamModContentFolder)/2925432336/1.6/Base/Assemblies/BigAndSmall.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BSXeno">
      <HintPath>$(SteamModContentFolder)/2925432336/1.6/Base/Assemblies/BSXeno.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Zlepper.RimWorld.ModSdk" />

  <!-- @(RimWorldCompilationResult) is normally defined inside the SDK's CopyMod
       target, which is disabled below. GenerateDefXsds also needs it so the
       schema reflects over the mod's own dll and includes its Def subclasses. -->
  <Target Name="PrepareDefXsdGeneration" BeforeTargets="GenerateDefXsds">
    <ItemGroup>
      <RimWorldCompilationResult Include="$(ModSpecificOutputFolder)\**" />
    </ItemGroup>
  </Target>

  <!-- Deployment is handled by sync.sh (keeps the hand-written About.xml authoritative).
       The SDK's CopyMod would deploy a generated minimal About.xml missing Biotech,
       Modlist Configurator and the loadAfter list, and create a duplicate mod folder. -->
  <Target Name="CopyMod" />
</Project>